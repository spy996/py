# ============ 科技项目管理系统 环境配置模板 ============
# 说明：首次启动会通过「首启向导」自动生成数据目录下的 .env（默认
#   %LOCALAPPDATA%\RDPlatform\data\.env），本文件仅为参考模板。
# 数据目录（DATA_DIR）优先级：
#   1) 环境变量 RD_DATA_DIR
#   2) 安装目录存在 _packaged 标记 → %LOCALAPPDATA%\RDPlatform\data
#   3) 开发/旧部署 → 程序所在目录

# ---- DeepSeek 大模型（智能问答、文件分类、摘要、字段识别）----
# 可留空：留空则 AI 相关能力自动降级为兜底逻辑，后续可随时补填。
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# ---- 管理员登录（登录 Web 界面，必填）----
ADMIN_USERNAME=admin
# 管理员初始密码：首次启动会被自动哈希为 ADMIN_PASSWORD_HASH 并从本文件删除明文
ADMIN_PASSWORD=

# ---- 文件存储目录（可选）----
# 留空或删除本行 = 自动使用「数据目录下的 uploads 文件夹」
# 如需指定其他位置，改成绝对路径，例如：UPLOAD_DIR=D:\my_data
# UPLOAD_DIR=

# 以下密钥首次启动会自动生成并写入 .env，无需手动填写：
#   TOKEN_SECRET          —— 登录令牌签名密钥
#   BOT_TOKEN             —— 内部服务 token（单机版保留，无 QQ 机器人）
#   BACKUP_KEY            —— 备份加密密钥（Fernet）
# 可选项：
#   BACKUP_KEEP=10          —— 自动备份保留份数（默认 10）
#   AUDIT_RETENTION_DAYS=90 —— 审计日志保留天数（默认 90）
