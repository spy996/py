# ============ 研发知识智能管理平台 环境配置（示例）============
# 使用方法：把本文件复制一份，改名为 .env，然后填入下面的真实值。
# 注意：.env 含密钥，切勿提交到网盘/仓库或分享给他人。

# ---- DeepSeek 大模型（智能问答、文件分类、摘要、字段识别都用到，必填）----
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# ---- 文件存储目录（文件本体 + 提取出的文本）----
# 留空或删除本行 = 自动使用「项目目录下的 data 文件夹」（推荐，便于整体迁移）
# 如需指定其他位置，改成绝对路径，例如：UPLOAD_DIR=D:\my_data
# UPLOAD_DIR=

# ---- QQ 机器人（手机 QQ 单聊收发文件，可选，不用可留空）----
# 到 q.qq.com 用手机 QQ 扫码注册开发者并创建机器人，把 AppID / AppSecret 填到下面
# 留空则不影响 Web 界面，仅关闭手机 QQ 收发功能
QQ_APP_ID=
QQ_APP_SECRET=
# 可选：只响应这些 user_openid（逗号分隔），留空 = 不限制（首个发消息者自动授权）
QQ_ALLOWED_OPENIDS=

# ---- 登录认证与安全 ----
# 管理员账号（登录 Web 界面用）
ADMIN_USERNAME=admin
# 管理员初始密码（首次启动会自动哈希为 ADMIN_PASSWORD_HASH 并从本文件删除明文）
ADMIN_PASSWORD=
# 请自行设置至少 12 位的唯一密码；不要使用示例密码或与其他账号相同的密码。

# 以下密钥首次启动会自动生成并写入 .env，无需手动填写：
#   TOKEN_SECRET  —— 登录令牌签名密钥
#   BOT_TOKEN     —— QQ 机器人访问后端内部服务令牌
#   BACKUP_KEY    —— 备份加密密钥（Fernet）
# 可选项：
#   BACKUP_KEEP=10          —— 自动备份保留份数（默认 10）
#   AUDIT_RETENTION_DAYS=90 —— 审计日志保留天数（默认 90）
